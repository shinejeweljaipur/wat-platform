# ---- Required ----
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=put-a-long-random-string-here
# First admin login (created automatically on first start if no users exist)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# ---- Meta (WhatsApp Cloud API) - one Meta app serves all your numbers ----
WA_VERIFY_TOKEN=choose-any-secret-string
WA_APP_SECRET=your-meta-app-secret
WA_GRAPH_VERSION=v21.0

# ---- Optional ----
# Protects /api/cron/tick (only needed if you trigger the queue from an external cron instead of the built-in worker)
CRON_SECRET=
# Set to 0 to disable the built-in background worker (e.g. on serverless hosts)
ENABLE_WORKER=1
